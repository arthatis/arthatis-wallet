# Salin ke .env. Jangan commit .env.
PORT=8787
# Origin web mirror (dipakai di tautan email pemulihan)
APP_ORIGIN=https://wallet.example.com
# Origin yang boleh memanggil API. "*" untuk semua.
CORS_ORIGIN=*

# Opsional: email (kode verifikasi + pemulihan akun + formulir kontak).
# Pakai SMTP sendiri (mis. Postfix di VPS, atau relay/penyedia SMTP mana pun):
SMTP_HOST=
SMTP_PORT=587
# 465 = TLS langsung; 587/25 = STARTTLS. Kosongkan untuk otomatis menurut port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Arthatis Wallet <wallet@example.com>
CONTACT_TO=

# Opsional: AI lokal di server (Ollama / OpenAI-compatible)
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=

# --- Aturan server -------------------------------------------------------------------------------
# Vault pertama yang mendaftar menjadi admin server ini. Daftar segera setelah server menyala.
# open  = siapa pun yang tahu URL boleh mendaftar.  email = hanya email di allowlist admin (butuh SMTP).
REGISTRATION_MODE=open
# Server hosted: vault harus diaktifkan lewat admin API sebelum bisa sinkron (self-host: biarkan false).
REQUIRE_ACTIVATION=false
# Tautan halaman bayar yang ditampilkan app untuk vault yang belum aktif (hanya hosted).
PAY_URL=
# Token untuk layanan lain (mis. situs pembayaran) memanggil /v1/admin. Kosong = hanya vault admin.
ADMIN_API_TOKEN=
# Hapus vault yang tidak pernah diaktifkan setelah N hari; batas pendaftaran per IP per jam (hanya bila REQUIRE_ACTIVATION=true).
PENDING_PURGE_DAYS=7
REGISTER_RATE_PER_HOUR=20
# Percaya header X-Forwarded-For (hanya di belakang reverse proxy milikmu sendiri).
TRUST_PROXY=false
